# ════════════════════════════════════════════════════════════════════════════
#  Boutique en marque blanche — configuration d'une instance client
#
#  1. cp .env.example .env
#  2. php artisan key:generate
#  3. Renseigner les sections marquées ★ (obligatoires)
#  4. php artisan migrate --seed
#
#  Nom, couleurs, logo, modules, paiements affichés, zones de livraison :
#  tout le reste se règle depuis l'administration (Paramètres).
#  Ne jamais committer un .env rempli : il contient des secrets.
# ════════════════════════════════════════════════════════════════════════════

# ★ Identité technique ───────────────────────────────────────────────────────
# Nom par défaut de la boutique (repris dans les réglages à l'installation,
# modifiable ensuite dans l'admin).
APP_NAME="Ma Boutique"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:7010
# URL publique de la vitrine (front Vue)
APP_FRONTEND_URL=http://127.0.0.1:5180
FRONTEND_URL="${APP_FRONTEND_URL}"
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ★ Compte du propriétaire (créé par `php artisan migrate --seed`) ────────────
OWNER_EMAIL=
OWNER_NAME=
# Vide : un mot de passe est généré et affiché une seule fois.
OWNER_PASSWORD=

# Catalogue de démonstration neutre (instance de démo commerciale uniquement)
SEED_DEMO=false

# SEO : domaine de production autorisé à être indexé (ex. maboutique.com).
# Vide : seule APP_ENV=production est indexée.
SEO_INDEXABLE_HOST=

# ── Logs ────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# ★ Base de données ──────────────────────────────────────────────────────────
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=boutique
# DB_USERNAME=boutique
# DB_PASSWORD=

# ── Session / Cache / Queue ─────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# En production : .maboutique.com
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=reverb

# ── Sanctum / CORS ──────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5180,localhost:5180
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180

# ★ E-mail (SMTP de la boutique) ─────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ── Paiements (n'activer que ceux dont la boutique a un contrat) ─────────────
# Stripe (Laravel Cashier) — paiement carte via Checkout
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=eur                      # Stripe ne supporte pas le XOF
STRIPE_XOF_PER_EUR=655.957                # Taux fixe franc CFA → euro
STRIPE_SUCCESS_URL="${APP_FRONTEND_URL}/payment/return?order={order_number}"
STRIPE_CANCEL_URL="${APP_FRONTEND_URL}/payment/return?order={order_number}&status=cancelled"

# Wave
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_ENVIRONMENT=sandbox
ORANGE_MONEY_API_KEY=

# CinetPay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_RETURN_BASE_URL="${APP_FRONTEND_URL}"

# GeniusPay (Wave / Orange Money en ligne)
GENIUSPAY_API_KEY=
GENIUSPAY_SECRET_KEY=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_RETURN_BASE_URL="${APP_FRONTEND_URL}"

# ── Connexion sociale (facultatif) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/api/auth/facebook/callback"

# ── WhatsApp Cloud API (facultatif) ─────────────────────────────────────────
# Diagnostic complet : php artisan shop:whatsapp-doctor
#
# Jeton d'UTILISATEUR SYSTÈME, jamais le jeton temporaire du tableau de bord :
# ce dernier expire en 24 h. Business Manager → Utilisateurs système → Générer.
WHATSAPP_API_TOKEN=
# Identifiant du NUMÉRO (Phone number ID), pas celui du compte.
WHATSAPP_PHONE_NUMBER_ID=
# Identifiant du WhatsApp Business Account, qui porte les modèles de message.
WHATSAPP_WABA_ID=
# Chaîne libre, recopiée à l'identique côté Meta.
WHATSAPP_VERIFY_TOKEN=
# Clé secrète de l'application Meta : signe les messages entrants.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v22.0
# Modèles approuvés par Meta pour ce compte (noms au caractère près).
WHATSAPP_TPL_ORDER=order_confirmation
WHATSAPP_TPL_ADMIN_ORDER=admin_new_order
WHATSAPP_TPL_OTP=otp_code
WHATSAPP_TPL_LANG=fr

# ── Caisse : lecture des messages clients par IA (facultatif) ────────────────
POS_USE_CLAUDE=false

# ── Reverb (notifications temps réel de l'admin) ────────────────────────────
# Valeurs propres à chaque instance (php artisan reverb:install).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ── Vite (build frontend) ───────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Coquille du SPA servie par Laravel pour les balises SEO (voir SpaController).
# En local le front est servi par Vite : cette variable ne sert qu'en conteneur.
SPA_SHELL_URL=http://nginx/index.html
